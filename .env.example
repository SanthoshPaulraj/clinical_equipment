# Application Configuration
APP_ENV=development
API_PORT=8000
DASHBOARD_PORT=8501

# Database Configuration
DATABASE_URL=sqlite:///./hospital_equipment.db

# Impact Score Weights (Total should be 1.0)
WEIGHT_URGENCY=0.30
WEIGHT_PROCEDURES_AFFECTED=0.25
WEIGHT_ALTERNATIVE_RISK=0.20
WEIGHT_REPAIR_TIME=0.15
WEIGHT_SERVICE_CRITICALITY=0.10

# Priority Thresholds
THRESHOLD_CRITICAL=90
THRESHOLD_HIGH=75
THRESHOLD_MEDIUM=50

# Freshness Thresholds (in hours)
FRESH_THRESHOLD=1
STALE_THRESHOLD=6
